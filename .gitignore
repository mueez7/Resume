# ===========================
# Root .gitignore — Aura AI Resume Analyzer
# ===========================

# ---- Node / npm ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ---- Environment variables (NEVER commit secrets) ----
.env
.env.*
!.env.example
!.env.local.example

# ---- Frontend (Next.js) ----
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ---- Backend (TypeScript / Node) ----
backend/dist/

# ---- OS & Editor ----
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
